# =============================================
# BillPro Backend — Environment Configuration
# Copy this file to .env and fill in values
# =============================================

# App
NODE_ENV=development
PORT=8082
APP_NAME=BillQube
APP_URL=http://localhost:8587
FRONTEND_URL=http://localhost:8587
SITE_URL=http://localhost:8587
ITEM_IMAGE=/uploads/Item/

# MongoDB
MONGO_URI=mongodb://localhost:27017/billpro
MONGO_URI_TEST=mongodb://localhost:27017/billpro_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (use RS256 — generate RSA keys: openssl genrsa -out private.pem 2048)
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_EXPIRES=30d
JWT_REFRESH_EXPIRES=30d

# OTP
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# SMS Gateway (MSG91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=your_sender_id
MSG91_TEMPLATE_ID=your_template_id

# Email (SMTP Configuration)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=your_app_name
BREVO_API_KEY=your_brevo_api_key

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET=your_s3_bucket_name

# GST / E-Invoice (GSP Provider)
GSP_API_URL=https://gsp-provider-sandbox.example.com/api
GSP_API_KEY=your_gsp_api_key
GSP_USERNAME=your_gsp_username
GSP_PASSWORD=your_gsp_password
GSTIN_VALIDATE_URL=https://api.gst.gov.in/

# E-Way Bill (NIC)
EWB_API_URL=https://ewaybillgst.gov.in/api
EWB_USERNAME=your_ewb_username
EWB_PASSWORD=your_ewb_password

# IFSC Validation (RazorpayX)
RAZORPAY_IFSC_URL=https://ifsc.razorpay.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_ATTACHMENT_SIZE_MB=5
MAX_LOGO_SIZE_MB=2
MAX_IMPORT_SIZE_MB=10

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Encryption (AES-256 for PAN/Aadhaar)
ENCRYPTION_KEY=your_aes_256_encryption_key_32_characters

# BullMQ (Queue names)
QUEUE_PDF_GENERATION=pdf-generation
QUEUE_EMAIL_SEND=email-send
QUEUE_GST_RETRY=gst-retry
