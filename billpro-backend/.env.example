# =============================================
# BillPro Backend — Environment Configuration
# Copy this file to .env and fill in values
# =============================================

# App
NODE_ENV=development
PORT=8587
APP_NAME=BillPro
APP_URL=http://localhost:8587
FRONTEND_URL=http://localhost:8587
SITE_URL=http://localhost:8587
ITEM_IMAGE=/uploads/Item/

# MongoDB
MONGO_URI=mongodb+srv://niravgajera502_db_user:gCC6Ol8oRHb5gJkh@billingdemo.qrkyul5.mongodb.net/?appName=BillingDemo
MONGO_URI_TEST=mongodb://localhost:27017/billpro_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (use RS256 — generate RSA keys: openssl genrsa -out private.pem 2048)
JWT_ACCESS_SECRET=BILLING_PRO_DEMO_SECRET
JWT_REFRESH_SECRET=BILLING_PRO_DEMO_SECRET
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=30d

# OTP
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# SMS Gateway (MSG91)
MSG91_AUTH_KEY=your_msg91_key
MSG91_SENDER_ID=BLLPRO
MSG91_TEMPLATE_ID=your_template_id

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_key
EMAIL_FROM=noreply@billpro.in
EMAIL_FROM_NAME=BillPro

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=ap-south-1
AWS_S3_BUCKET=billpro-uploads

# GST / E-Invoice (GSP Provider)
GSP_API_URL=https://gsp-provider.example.com/api
GSP_API_KEY=your_gsp_key
GSP_USERNAME=your_gsp_username
GSP_PASSWORD=your_gsp_password
GSTIN_VALIDATE_URL=https://api.gst.gov.in/

# E-Way Bill (NIC)
EWB_API_URL=https://ewaybillgst.gov.in/api
EWB_USERNAME=your_ewb_username
EWB_PASSWORD=your_ewb_password

# IFSC Validation (RazorpayX)
RAZORPAY_IFSC_URL=https://ifsc.razorpay.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_ATTACHMENT_SIZE_MB=5
MAX_LOGO_SIZE_MB=2
MAX_IMPORT_SIZE_MB=10

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Encryption (AES-256 for PAN/Aadhaar)
ENCRYPTION_KEY=32_char_hex_key_here_for_aes256

# BullMQ (Queue names)
QUEUE_PDF_GENERATION=pdf-generation
QUEUE_EMAIL_SEND=email-send
QUEUE_GST_RETRY=gst-retry
